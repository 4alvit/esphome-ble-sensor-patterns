{
  "repository": "4alvit/esphome-ble-sensor-patterns",
  "mode": "validation-only",
  "default_branch": "main",
  "validation_workflows": [
    "validate.yml",
    "ci.yml",
    "codeql.yml",
    "dependency-review.yml",
    "security.yml"
  ],
  "local_checks": [
    "bash scripts/ci.sh"
  ],
  "notes": [
    "Validation-only policy: no synthetic beta/RC artifacts or tag-triggered stable releases.",
    "All eight complete examples require the pinned ESPHome compile matrix; JBD/Daly external sources are commit-pinned. No CI flashing or hardware BLE/MQTT checks."
  ],
  "esphome_configs": [
    "patterns/ble-temp-sensor/generic-ble-temp.yaml",
    "patterns/ble-temp-sensor/inkbird-ibs-th1.yaml",
    "patterns/ble-temp-sensor/xiaomi-lywsd03mmc.yaml",
    "patterns/daly-bms/multi-bms.yaml",
    "patterns/daly-bms/single-bms.yaml",
    "patterns/jbd-bms/multi-bms.yaml",
    "patterns/jbd-bms/single-bms.yaml",
    "patterns/xiaomi-mi-flora/mi-flora.yaml"
  ],
  "esphome_version": "2026.10.0b1",
  "visibility": "public",
  "single_entry_ci": true
}
